# Hermes Agent environment file for Haven.
#
# Hermes reads user-managed secrets from the `.env` inside its configuration
# home: $HERMES_HOME/.env. Defaults are ~/.hermes on POSIX and
# %LOCALAPPDATA%\hermes on Windows.
#
#   cp agent/hermes.env.example "$HERMES_HOME/.env"
#
# Formats verified against the official Hermes documentation:
#   https://hermes-agent.nousresearch.com/docs/reference/environment-variables
#   https://hermes-agent.nousresearch.com/docs/integrations/providers
#   https://hermes-agent.nousresearch.com/docs/reference/cli-commands
#
# Only the variables marked "documented" below are Hermes variables. Read the
# NOTES before adding anything: one variable that was requested for this file
# could not be verified and is deliberately left disabled.

# ── Inference: Nebius Token Factory ──────────────────────────────────────
# NEBIUS_API_KEY -- documented as "Nebius Token Factory API key"
#   (https://tokenfactory.nebius.com/). NEBIUS_TOKEN_FACTORY_API_KEY is also
#   accepted as an alias.
# This is what routes the agent to Nebius Token Factory instead of any other
# inference host. Provider id: nebius-token-factory
# (aliases: nebius, nebius-tf, tokenfactory).
NEBIUS_API_KEY=replace-with-your-nebius-token-factory-key

# NEBIUS_BASE_URL -- documented override; documented default
#   https://api.tokenfactory.nebius.com/v1
# Keeping inference on this host is the point of using NEBIUS_API_KEY at all.
# NOTE: the Haven pipeline (src/haven/llm.py) defaults to the region-specific
#   https://api.tokenfactory.us-central1.nebius.com/v1/ and reads this variable
#   as its override, so one value can serve both. Both hosts are allowlisted in
#   policy/policy.yaml.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# ── Research: Tavily ─────────────────────────────────────────────────────
# TAVILY_API_KEY -- documented as the Tavily API key for higher search/extract
#   limits (https://app.tavily.com/home). Hermes' web_search and web_extract
#   tools are what the pipeline's Tavily calls surface as.
TAVILY_API_KEY=replace-with-your-tavily-key

# TAVILY_BASE_URL -- documented as an override for the Tavily API endpoint,
#   for corporate proxies and self-hosted Tavily-compatible backends. The
#   official reference states no default for it, so it is left unset here.
#TAVILY_BASE_URL=

# ── Hermes home ──────────────────────────────────────────────────────────
# HERMES_HOME -- documented as selecting the configuration and user-data home.
#   A literal ~ or $VAR in the value is expanded, so it never resolves relative
#   to the current directory. Documented defaults: ~/.hermes (POSIX),
#   %LOCALAPPDATA%\hermes (Windows), /opt/data (official Docker image).
# Uncomment only if you want a Haven-scoped home instead of the default.
#HERMES_HOME=~/.hermes

# ── Model selection ──────────────────────────────────────────────────────
# HERMES_INFERENCE_MODEL -- documented in the environment-variables reference:
#   "Override model name at process level (takes priority over config.yaml for
#   the session). Also settable via -m/--model flag."
# Hermes runs one main model per session, so pick the tier the stage needs and
# switch it between stages; there is no per-call tier switch. Tier model ids
# used by the Haven pipeline (src/haven/llm.py, TIER_MODELS):
#   nano   nvidia/nemotron-3-nano-30b          <-- id is UNVERIFIED in llm.py
#   super  nvidia/nemotron-3-super-120b-a12b
#   ultra  nvidia/Nemotron-3-Ultra-550b-a55b   <-- note the capitalisation
# nano for extraction/classification/routing, super for judgement and drafting,
# ultra only for multi-site strategy over long context.
HERMES_INFERENCE_MODEL=nvidia/nemotron-3-super-120b-a12b

# ── NOT DOCUMENTED: HERMES_INFERENCE_PROVIDER ────────────────────────────
# HERMES_INFERENCE_PROVIDER was requested for this file but COULD NOT BE
# VERIFIED against the official documentation. It does not appear in the
# environment-variables reference, and the CLI reference lists the
# `--provider` flag's "Equivalent env var" as _none_. Setting it would be
# guessing, so it is left disabled -- do not rely on it.
#
# Pin the provider the documented ways instead.
#
# (a) In $HERMES_HOME/config.yaml -- model.provider is the source of truth:
#
#       model:
#         provider: "nebius-token-factory"      # alias: nebius
#         default: "nvidia/nemotron-3-super-120b-a12b"
#
# (b) Per run on the command line, which takes precedence for that run:
#
#       hermes chat --provider nebius --model nvidia/nemotron-3-super-120b-a12b
#
#HERMES_INFERENCE_PROVIDER=nebius-token-factory   # UNVERIFIED -- left disabled

# ── HARD RULE: never ship the NVIDIA Build endpoint ──────────────────────
# WARNING. NVIDIA_BASE_URL defaults to https://integrate.api.nvidia.com/v1
# and NVIDIA_API_KEY points at build.nvidia.com (documented: "NVIDIA NIM API
# key -- Nemotron and open models (build.nvidia.com)"). The hackathon rules
# forbid integrate.api.nvidia.com and build.nvidia.com as the SHIPPED
# inference endpoint. Neither host may ever be the endpoint this agent talks
# to.
#
#   * Do NOT set NVIDIA_API_KEY.
#   * Do NOT set NVIDIA_BASE_URL, and never to either forbidden host.
#   * Do NOT "blank" them as a fix. An unset NVIDIA_BASE_URL still resolves to
#     the forbidden default, so clearing the value proves nothing. The
#     requirement is that NVIDIA_API_KEY is absent, so the `nvidia` provider
#     can never be selected, and that model.provider points at Nebius.
#   * If a stale NVIDIA_* value is already in the process environment or in
#     $HERMES_HOME/.env, remove it. src/haven/llm.py encodes the same rule as
#     FORBIDDEN_INFERENCE_HOSTS.
#
#NVIDIA_API_KEY=                                     # FORBIDDEN -- never set
#NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1 # FORBIDDEN -- never set

# ── Alternative documented path: custom OpenAI-compatible endpoint ───────
# The providers reference documents a "Custom Endpoint" entry (selected with
# `hermes model`, saved in config.yaml, reachable mid-session as the `custom`
# provider alias, e.g. `/model custom:<model>`). Its environment-variable form
# is OPENAI_BASE_URL plus OPENAI_API_KEY. The reference states that, bound that
# way, the key "is sent only to that URL's exact origin (scheme, host and
# port), never to another port or to http:// on the same host".
#
# Use this only as a fallback if the first-class nebius-token-factory provider
# is unavailable. NEBIUS_API_KEY + model.provider is the supported path.
#
#OPENAI_BASE_URL=https://api.tokenfactory.nebius.com/v1
#OPENAI_API_KEY=replace-with-your-nebius-token-factory-key
