# Copy to .env and replace the placeholders. Never commit real credentials.
NEBIUS_API_KEY=replace-with-your-nebius-token-factory-key
TAVILY_API_KEY=replace-with-your-tavily-key

# ── Inference endpoint ────────────────────────────────────────────────
# Default: the region-specific host mandated by the project brief. Nebius
# documents public endpoints as global and warns that a region-specific
# base URL "can stop working if the endpoint's processing region changes".
# If inference starts failing, switch to the documented region-free host:
#   NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Both hosts are allowlisted in policy/policy.yaml.
# NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/

# ── Model overrides (optional) ────────────────────────────────────────
# The nano tier id below is UNVERIFIED -- it does not appear in the official
# Nebius cookbook. Run `python scripts/verify_models.py`, then set the id it
# reports. Candidates:
#   nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
#   nvidia/Nemotron-3_5-Lightning
# Super and ultra are confirmed present in the cookbook.
# NEBIUS_MODEL_NANO=nvidia/nemotron-3-nano-30b
# NEBIUS_MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
# NEBIUS_MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b

# ── Evidence ──────────────────────────────────────────────────────────
# Where the OpenShell OCSF JSONL audit log is collected. Accepts a glob so a
# rotating filename works. The supervisor's own copy is not readable from
# inside the sandbox; collect it from the host instead.
# HAVEN_AUDIT_LOG=/var/log/openshell-ocsf*.log
